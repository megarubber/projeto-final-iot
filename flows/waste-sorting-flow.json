  {
    "id": "n_in_event",
    "type": "mqtt in",
    "z": "waste_tab",
    "name": "Waste events",
    "topic": "waste/+/event",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 120,
    "wires": [
      [
        "n_process",
        "n_dbg"
      ]
    ]
  },
  {
    "id": "n_dbg",
    "type": "debug",
    "z": "waste_tab",
    "name": "Raw event",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 360,
    "y": 60,
    "wires": []
  },
  {
    "id": "n_process",
    "type": "function",
    "z": "waste_tab",
    "name": "Process event",
    "func": "const THRESHOLD = 50;   // items before the \"bin full\" alert\nconst ev = msg.payload || {};\nconst type = String(ev.type || '').toUpperCase();\n\nif (type !== 'WET' && type !== 'DRY') {\n    node.warn('Unknown waste type: ' + type);\n    return null;\n}\n\nconst stats = flow.get('stats') || { wet: 0, dry: 0, total: 0 };\nif (type === 'WET') { stats.wet++; } else { stats.dry++; }\nstats.total = stats.wet + stats.dry;\nflow.set('stats', stats);\n\nconst bin = msg.topic.split('/')[1];\nconst when = new Date().toLocaleTimeString('pt-BR');\n\nconst out = [\n    { payload: stats.total },\n    { payload: stats.wet },\n    { payload: stats.dry },\n    { topic: type === 'WET' ? 'Wet' : 'Dry', payload: type === 'WET' ? stats.wet : stats.dry },\n    { payload: bin + ': ' + type + ' at ' + when + ' (RSSI ' + ev.rssi + ' dBm)' },\n    null\n];\n\nif (stats.total % THRESHOLD === 0) {\n    out[5] = { payload: 'Bin reached ' + stats.total + ' items. Check if it needs emptying.' };\n}\nreturn out;",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 160,
    "wires": [
      [
        "n_txt_total"
      ],
      [
        "n_txt_wet"
      ],
      [
        "n_txt_dry"
      ],
      [
        "n_chart"
      ],
      [
        "n_txt_last"
      ],
      [
        "n_notify"
      ]
    ]
  },
  {
    "id": "n_in_status",
    "type": "mqtt in",
    "z": "waste_tab",
    "name": "Receiver status",
    "topic": "waste/+/receiver/status",
    "qos": "1",
    "datatype": "utf8",
    "broker": "mqtt_broker",
